# Copy to .env and fill in the password. .env is git-ignored.
FTP_HOST=ftpcluster.loopia.se
FTP_PORT=21
FTP_USER=experimentsoul
FTP_PASSWORD=
# Explicit FTP over TLS (FTPS). Loopia supports it; keep it on.
FTP_SECURE=true
# Folder the site is uploaded to. Must be the expandialabs.com folder,
# never another domain on the same Loopia account.
FTP_REMOTE_DIR=/expandialabs.com/public_html
