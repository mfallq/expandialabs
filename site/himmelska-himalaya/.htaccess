# Published as .htaccess in the site's folder on expandialabs.com.
# It adjusts one rule inherited from the main site's .htaccess.
#
# Caching: the main site caches CSS and JS for a year because its files carry
# ?v= versions. These files do not, and the service worker already keeps an
# offline copy, so ask the browser to revalidate instead.
#
# The main site's Content-Security-Policy is left as it is: everything this
# site loads comes from its own folder.
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(woff2|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
